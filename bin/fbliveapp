#!/bin/bash

export TEXTDOMAIN="flux-tools"

LOCALE="$(echo "$LANG" | cut -d. -f1)"
LNG="$(echo "$LANG" | cut -d_ -f1)"
GUEST=false
RUN_AS_ROOT=false
POSTINSTALL=""

if [ "$LOCALE" != "en_US" ] && [ "$LOCALE" != "C" ]; then
   case "$LOCALE" in
   "es_ES" | "pt_BR")
      LNG="$(echo "$LOCALE" | tr '[:upper:]' '[:lower:]')"
      ;;
   esac
fi

if [ "$1" = "vlc" ]; then
   NAME="$(gettext "VLC Video Player")"
   ABOUT="$(gettext "VLC is a free and open source multimedia player that plays most media files and streaming protocols.")"
   EXECUTABLE="/usr/bin/vlc"
   PREINSTALL="apt update"
   INSTALL="apt install --yes vlc"
   if [ "$EUID" -eq 0 ]; then
      GUEST=true
      VLC_USER="guest"
   else
      VLC_USER="$(id -un)"
   fi
   VLC_HOME="$(getent passwd "$VLC_USER" | cut -d: -f6)"
   VLC_UID="$(id -u "$VLC_USER")"
   VLC_GID="$(id -g "$VLC_USER")"
   POSTINSTALL="rm -f /usr/share/applications/vlc.desktop && install -d -o $VLC_UID -g $VLC_GID '$VLC_HOME/.config/vlc' && printf '[qt4]\\nqt-privacy-ask=0\\n' > '$VLC_HOME/.config/vlc/vlcrc' && chown $VLC_UID:$VLC_GID '$VLC_HOME/.config/vlc/vlcrc'"
fi

if [ "$1" = "chromium" ]; then
   NAME="$(gettext "Chromium Web Browser")"
   ABOUT="$(gettext "Chromium is a free and open source version of the famous Chrome browser, developed by Google.")"
   EXECUTABLE="/usr/bin/chromium"
   PREINSTALL="apt update"
   INSTALL="apt install --yes chromium chromium-sandbox"
   POSTINSTALL="rm -f /usr/share/applications/chromium.desktop"
   if [ "$EUID" -eq 0 ]; then
      GUEST=true
   fi
fi

if [ "$1" = "firefox-esr" ]; then
   NAME="$(gettext "Firefox Web Browser")"
   ABOUT="$(gettext "Firefox is a free and open source browser.")"
   EXECUTABLE="/usr/bin/firefox-esr"
   PREINSTALL="apt update"
   if [ "$LOCALE" != "en_US" ] && [ "$LOCALE" != "C" ]; then
      INSTALL="apt install --yes firefox-esr firefox-esr-l10n-$LNG minios-welcome"
   else
      INSTALL="apt install --yes firefox-esr minios-welcome"
   fi
   POSTINSTALL="rm -f /usr/share/applications/firefox-esr.desktop"
   GUEST=false
fi

if [ "$1" = "minios-installer" ]; then
   NAME="$(gettext "MiniOS Installer")"
   ABOUT="$(gettext "MiniOS Installer allows you to install MiniOS on the media.")"
   EXECUTABLE="/usr/bin/minios-installer"
   PREINSTALL="apt update"
   INSTALL="apt install --yes minios-installer"
   POSTINSTALL="rm -f /usr/share/applications/minios-installer.desktop"
   GUEST=false
   RUN_AS_ROOT=true
fi

if [ "$1" = "minios-configurator" ]; then
   NAME="$(gettext "MiniOS Configurator")"
   ABOUT="$(gettext "MiniOS Configurator allows you to configure MiniOS.")"
   EXECUTABLE="/usr/bin/minios-configurator"
   PREINSTALL="apt update"
   INSTALL="apt install --yes minios-configurator"
   POSTINSTALL="rm -f /usr/share/applications/minios-configurator.desktop"
   GUEST=false
   RUN_AS_ROOT=true
fi

if [ "$1" = "minios-session-manager" ]; then
   NAME="$(gettext "MiniOS Session Manager")"
   ABOUT="$(gettext "MiniOS Session Manager allows you to manage persistent sessions.")"
   EXECUTABLE="/usr/bin/minios-session-manager"
   PREINSTALL="apt update"
   INSTALL="apt install --yes minios-session-manager"
   POSTINSTALL="rm -f /usr/share/applications/minios-session-manager.desktop"
   GUEST=false
fi

if [ "$1" = "minios-kernel-manager" ]; then
   NAME="$(gettext "MiniOS Kernel Manager")"
   ABOUT="$(gettext "MiniOS Kernel Manager allows you to manage Linux kernels.")"
   EXECUTABLE="/usr/bin/minios-kernel-manager"
   PREINSTALL="apt update"
   INSTALL="apt install --yes minios-kernel-manager"
   POSTINSTALL="rm -f /usr/share/applications/minios-kernel-manager.desktop"
   GUEST=false
fi

if [ "$1" = "minios-module-manager" ]; then
   NAME="$(gettext "MiniOS Module Manager")"
   ABOUT="$(gettext "Inspect, create and manage MiniOS modules.")"
   EXECUTABLE="/usr/bin/minios-module-manager"
   PREINSTALL="apt update"
   INSTALL="apt install --yes minios-module-manager"
   POSTINSTALL="rm -f /usr/share/applications/minios-module-manager.desktop"
   GUEST=false
fi

if [ "$1" = "minios-image-builder" ]; then
   NAME="$(gettext "MiniOS Image Builder")"
   ABOUT="$(gettext "Build a verified MiniOS image with system, boot, layer, and session customization")"
   EXECUTABLE="/usr/bin/minios-image-builder"
   PREINSTALL="apt update"
   INSTALL="apt install --yes minios-image-builder"
   POSTINSTALL="rm -f /usr/share/applications/minios-image-builder.desktop"
   GUEST=false
fi

if [ "$1" = "minios-store" ]; then
   NAME="$(gettext "MiniOS Store")"
   ABOUT="$(gettext "Install applications and build MiniOS modules")"
   EXECUTABLE="/usr/bin/minios-store-launcher"
   PREINSTALL="apt update"
   INSTALL="apt install --yes minios-store minios-store-gui"
   POSTINSTALL="rm -f /usr/share/applications/minios-store.desktop"
   GUEST=false
fi

if [ "$1" = "minios-help" ]; then
   NAME="$(gettext "MiniOS Help")"
   ABOUT="$(gettext "Browse the local MiniOS documentation")"
   EXECUTABLE="/usr/bin/minios-help"
   PREINSTALL="apt update"
   INSTALL="apt install --yes minios-help"
   # Also remove the launcher from older packages still in repositories.
   POSTINSTALL="rm -f /usr/share/applications/minios-help.desktop /usr/share/applications/dev.minios.Help.desktop"
   GUEST=false
fi

if [ "$1" = "driveutility" ]; then
   NAME="$(gettext "Drive Utility")"
   ABOUT="$(gettext "Write disk images, format, or wipe drives")"
   EXECUTABLE="/usr/bin/driveutility"
   PREINSTALL="apt update"
   INSTALL="apt install --yes driveutility"
   POSTINSTALL="rm -f /usr/share/applications/driveutility.desktop /usr/share/applications/driveutility-kde.desktop"
   GUEST=false
fi

shift

# ------------------------------------------------
#   do not touch anything below this line
# ------------------------------------------------

if [ "$ABOUT" != "" ]; then
   ABOUT="$ABOUT

"
fi

if [ "$EXECUTABLE" = "" ]; then
   exit
fi

if [ ! -f "$EXECUTABLE" ]; then

   if [ "$(uname -m)" != 'x86_64' ] && [ "$ONLY64" = "true" ]; then
      gtkask -i dialog-warning -t "$NAME" -m "$NAME $(gettext "only works in 64bit version of MiniOS")" -y "$(gettext "OK")"
      exit 1
   fi

   if gtkask -i dialog-question -t "$NAME" -m "$ABOUT$NAME$(gettext " is not yet installed. Do you like to download and install it now?")" -y "$(gettext "Yes")" -n "$(gettext "No")"; then
      # Clean up duplicate launchers only after a successful installation.
      # The shared MIME cache must remain readable with a private caller umask.
      INSTALL_COMMAND="$PREINSTALL && $INSTALL && { $POSTINSTALL; } && (umask 022; update-desktop-database --quiet /usr/share/applications)"
      if [ "$EUID" -ne 0 ]; then
         printf -v INSTALL_COMMAND 'pkexec bash -c %q' "$INSTALL_COMMAND"
      fi
      # xterm does not propagate its child's exit status. Record it from the
      # caller's shell, outside pkexec, in a private temporary directory.
      INSTALL_STATE=$(mktemp -d "${TMPDIR:-/tmp}/fbliveapp.XXXXXX") || exit 1
      trap 'rm -f -- "$INSTALL_STATE/status"; rmdir -- "$INSTALL_STATE"' EXIT
      printf -v TERMINAL_COMMAND '%s; result=$?; printf "%%s\\n" "$result" >%q; exit "$result"' \
         "$INSTALL_COMMAND" "$INSTALL_STATE/status"
      xterm -ls -e bash --login -c -- "$TERMINAL_COMMAND" || exit $?
      [ -f "$INSTALL_STATE/status" ] &&
         IFS= read -r INSTALL_STATUS <"$INSTALL_STATE/status" || exit 1
      case "$INSTALL_STATUS" in
         0) ;;
         ''|*[!0-9]*) exit 1 ;;
         *) exit "$INSTALL_STATUS" ;;
      esac
      rm -f -- "$INSTALL_STATE/status"
      rmdir -- "$INSTALL_STATE"
      trap - EXIT
   fi
fi

if [ -f "$EXECUTABLE" ]; then

   fbstartupnotify

   if [ "$GUEST" = "true" ]; then
      xhost +SI:localuser:guest >/dev/null 2>/dev/null
      exec runuser -u guest -- "$EXECUTABLE" "$@"
   fi

   if [ "$RUN_AS_ROOT" = "true" ] && [ "$EUID" -ne 0 ]; then
      exec pkexec "$EXECUTABLE" "$@"
   fi

   exec "$EXECUTABLE" "$@"

fi
