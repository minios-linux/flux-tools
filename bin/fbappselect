#!/bin/bash

export TEXTDOMAIN="flux-tools"

# Static translation marker for xgettext extraction - extracted but not executed
if false; then
    # TRANSLATORS: Terminal message when command finishes
    gettext "Command finished. Press any key to close window..."
fi

export QT_STYLE_OVERRIDE=gtk
export QT_QPA_PLATFORMTHEME=gtk2

# Do not kill menus belonging to another session (or a logout dialog).
mkdir -p -- "$HOME/.fluxbox" || exit $?
exec 9>"$HOME/.fluxbox/fbappselect-${DISPLAY//[^a-zA-Z0-9_.-]/_}.lock" || exit $?
flock -n 9 || exit 0

TEMPCONF=$(mktemp "${TMPDIR:-/tmp}/fbappselect.XXXXXX") || exit 1
trap 'rm -f -- "$TEMPCONF"' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
if ! xlunch_genquick 64 --desktop >"$TEMPCONF"; then
   exit 1
fi

COMMAND=$(
  xlunch --border 7% --sideborder 10% --borderratio 100 --sideborderratio 50 \
         --backgroundcolor 00000066 \
         --background /usr/share/wallpapers/flux_wallpaper.jpg --bgfill --font /usr/share/fonts/opentype/inter/Inter-Regular.otf/10 \
         --button "/usr/share/icons/locolor/48x48/actions/xlunch-logout.png;/usr/share/icons/locolor/48x48/actions/xlunch-logout-hi.png;52;-2;fblogout" \
         --button "/usr/share/icons/hicolor/48x48/apps/org.xfce.panel.applicationsmenu.png;/usr/share/icons/hicolor/48x48/apps/org.xfce.panel.applicationsmenu-hi.png;2;-2;" \
         --button "/usr/share/icons/locolor/104x52/ui/slax-menu-bg.png;;0;-0;" \
         --voidclickterminate --iconpadding 40 --textpadding 10 \
         --leastmargin 6 --hidemissing --iconsize 64 \
         --highlight /usr/share/icons/hicolor/128x128/apps/xlunch_highlight.png \
         --outputonly --input "$TEMPCONF"
) || exit $?

exec 9>&-
rm -f -- "$TEMPCONF"

if [ "$COMMAND" = "" ]; then
   exit
fi

if [ "$COMMAND" = "fblogout" ]; then
   fblogout
   exit
fi

fbstartupnotify

# Desktop Exec values are not shell commands. GIO handles quoting, field
# codes, TryExec, Path and Terminal using the desktop entry specification.
if [[ "$COMMAND" == *.desktop ]]; then
   # Older GLib (for example 2.56) has no `gio launch`; GTK can launch
   # the desktop ID from the same XDG directories used by xlunch_genquick.
   if LC_ALL=C gio help 2>&1 | grep -q '^  launch[[:space:]]'; then
      LAUNCH=(gio launch "$COMMAND")
   else
      LAUNCH=(gtk-launch "${COMMAND##*/}")
   fi
   if [ -f "$COMMAND" ] && "${LAUNCH[@]}"; then
      exit 0
   else
      status=$?
      fbstartupnotify false
      if command -v gtkask >/dev/null 2>&1; then
         gtkask -i dialog-error -t "$(gettext "Error")" \
            -m "$(gettext "Could not start the selected application.")" \
            -y "$(gettext "OK")"
      fi
      exit "$status"
   fi
fi

# Free-form input is deliberately a shell command, unlike a desktop entry.
# Pass it as an argument, never interpolate it into the terminal wrapper.
exec xterm -ls -e bash -c '
   printf "%s\n" "$1"
   bash -lc "$1"
   status=$?
   printf "%s\n" "--------------------------------------------------"
   read -n 1 -s -r -p "$(gettext "Command finished. Press any key to close window...")"
   exit "$status"
' bash "$COMMAND"
