#!/bin/bash

export TEXTDOMAIN="flux-tools"
if [ "$#" -lt 1 ] || [ "$#" -gt 2 ] || { [ "$#" -eq 2 ] && [ "$2" != -n ]; }; then
    printf '%s\n' 'Usage: fbscreensize MODE [-n]' >&2
    exit 2
fi
OUTPUTS=$(xrandr --query) || exit $?
OUTPUT=$(awk '$2 == "connected" { if (!first) first=$1; if ($3 == "primary") primary=$1 }
    END { print primary ? primary : first }' <<<"$OUTPUTS")
if [ -z "$OUTPUT" ]; then
    printf '%s\n' "$(gettext "No connected display found.")" >&2
    exit 1
fi
xrandr --output "$OUTPUT" --mode "$1" || exit $?
[ "${2:-}" != -n ] || exit 0

# Compton supports reinitialization via SIGUSR1. Keep its arguments/settings,
# and never stop a compositor belonging to another user or X display.
while IFS= read -r pid; do
    [ -n "$pid" ] || continue
    if grep -zFxq -e "DISPLAY=${DISPLAY%.0}" -e "DISPLAY=${DISPLAY%.0}.0" "/proc/$pid/environ" 2>/dev/null; then
        kill -USR1 "$pid" || { kill -0 "$pid" 2>/dev/null && exit 1; }
    fi
done < <(pgrep -u "$EUID" -x compton)
exit 0
