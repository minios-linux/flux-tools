#!/bin/bash

export TEXTDOMAIN="flux-tools"

INITIALIZED_MARKER="$HOME/.fluxbox/fbdesktop.initialized"

mark_initialized() {
    mkdir -p "$(dirname "$INITIALIZED_MARKER")"
    touch "$INITIALIZED_MARKER"
}

if [ "$(id -u)" -eq 0 ]; then
    APPDIR="/usr/share/applications"
else
    APPDIR="$HOME/.local/share/applications"
fi

refresh_desktop_cache() {
    # GIO needs this cache to resolve the MimeType handlers in our launchers.
    # Refresh existing entries too, without restoring deleted user launchers.
    if [ -d "$APPDIR" ]; then
        update-desktop-database --quiet "$APPDIR"
    fi
}

create_desktop_file() {
    APP_NAME="$(gettext "$1")"
    EXEC_COMMAND="$2"
    ICON_NAME="$3"
    CATEGORIES="$4"
    MIME_TYPE="$5"
    STARTUP_WM_CLASS="$6"
    HIDDEN="$7"

    # Extract the actual command from EXEC_COMMAND
    if echo "$EXEC_COMMAND" | grep -q "fbliveapp"; then
        ACTUAL_COMMAND=$(echo "$EXEC_COMMAND" | awk '{print $2}')
        CHECK="false"
    else
        ACTUAL_COMMAND=$(echo "$EXEC_COMMAND" | awk '{print $1}')
        CHECK="true"
    fi

    # Generate the desktop filename, append '-flux' suffix
    FILENAME="${ACTUAL_COMMAND}-flux"

    # Check if command exists on the system
    if [ $CHECK = "false" ] || command -v $ACTUAL_COMMAND >/dev/null 2>&1; then

        # Avoid duplicating system desktop files in user dir
        if [ "$APPDIR" != "/usr/share/applications" ] && \
           [ -e "/usr/share/applications/${FILENAME}.desktop" ]; then
            # remove old user copy if present
            rm -f "$APPDIR/${FILENAME}.desktop"
            return
        fi

        # Create the applications directory if it doesn't exist
        mkdir -p "$APPDIR"

        # Write the .desktop file
        echo "[Desktop Entry]
Version=1.0
Name=$APP_NAME
Exec=$EXEC_COMMAND
Terminal=false
Type=Application
Icon=$ICON_NAME
Categories=$CATEGORIES
MimeType=$MIME_TYPE
StartupWMClass=$STARTUP_WM_CLASS
StartupNotify=true
Hidden=$HIDDEN" >"$APPDIR/${FILENAME}.desktop"
    fi
}

# The default Flux application entries are only a starting point. Once they
# have been created, keep the user's changes on later logins.
if [ -e "$INITIALIZED_MARKER" ]; then
    refresh_desktop_cache
    exit $?
fi

# Call function with different parameters
# Static translation markers for xgettext extraction - these are extracted but not executed
if false; then
    # TRANSLATORS: Desktop entry names
    gettext "Web Browser"
    gettext "Image Viewer"
    gettext "Video Player"
    gettext "Terminal"
    gettext "MiniOS Installer"
    gettext "MiniOS Configurator"
    gettext "Archiver"
    gettext "File Manager"
    gettext "Text Editor"
    gettext "Task Manager"
    gettext "Net Manager"
    gettext "Calculator"
    gettext "MiniOS Session Manager"
    gettext "MiniOS Kernel Manager"
    gettext "MiniOS Module Manager"
    gettext "MiniOS Image Builder"
    gettext "MiniOS Store"
    gettext "MiniOS Help"
    gettext "Drive Utility"
fi

create_desktop_file "Web Browser" "fbliveapp firefox-esr %U" "firefox-esr" "Network;WebBrowser;" "audio/*;image/*;video/*;application/pdf;application/x-pdf;text/html;text/xml;application/xhtml_xml;application/x-mimearchive;x-scheme-handler/http;x-scheme-handler/https;" "firefox" "false"
create_desktop_file "Image Viewer" "feh %U" "none.png" "Graphics;2DGraphics;RasterGraphics;" "image/*;" "feh" "true"
create_desktop_file "Video Player" "fbliveapp vlc" "multimedia-video-player" "AudioVideo;Player;" "" "" "false"
create_desktop_file "Terminal" "xterm -ls" "utilities-terminal" "System;Utility;" "" "" "false"
create_desktop_file "MiniOS Installer" "fbliveapp minios-installer" "usb-creator-gtk" "GTK;System;Settings;" "" "" "false"
create_desktop_file "MiniOS Configurator" "fbliveapp minios-configurator" "preferences-system" "GTK;System;" "" "" "false"
create_desktop_file "Archiver" "xarchiver %f" "xarchiver" "GTK;Archiving;Compression;Utility;" "application/x-arj;application/arj;application/x-bzip;application/x-bzip-compressed-tar;application/x-gzip;application/x-rar;application/x-rar-compressed;application/x-tar;application/x-zip;application/x-zip-compressed;application/zip;application/x-7z-compressed;application/x-compressed-tar;application/x-bzip2;application/x-bzip2-compressed-tar;application/x-lzma-compressed-tar;application/x-lzma;application/x-deb;application/deb;application/x-xz;application/x-xz-compressed-tar;" "xarchiver" "false"
create_desktop_file "File Manager" "pcmanfm %U" "system-file-manager" "System;FileTools;FileManager;Utility;Core;GTK;" "inode/directory;" "pcmanfm" "false"
create_desktop_file "Text Editor" "mousepad %f" "org.xfce.mousepad" "GTK;Utility;TextEditor;" "text/plain;" "mousepad" "false"
create_desktop_file "Task Manager" "lxtask" "utilities-system-monitor" "GTK;System;Monitor;" "" "lxtask" "false"
#create_desktop_file "Net Manager" "connman-gtk" "preferences-system-network" "" "" "connman-gtk" "false"
create_desktop_file "Calculator" "galculator" "galculator" "Utility" "" "false" "false"
create_desktop_file "MiniOS Session Manager" "fbliveapp minios-session-manager" "media-floppy" "System;Settings;" "" "" "false"
create_desktop_file "MiniOS Kernel Manager" "fbliveapp minios-kernel-manager" "package-x-generic" "System;Settings;" "" "" "false"
create_desktop_file "MiniOS Module Manager" "fbliveapp minios-module-manager %f" "office-database" "System;" "application/x-sb;" "" "false"
create_desktop_file "MiniOS Image Builder" "fbliveapp minios-image-builder" "isomaster" "GTK;System;" "" "" "false"
create_desktop_file "MiniOS Store" "fbliveapp minios-store" "system-software-install" "System;PackageManager;" "" "" "false"
create_desktop_file "MiniOS Help" "fbliveapp minios-help" "system-help" "System;Documentation;" "" "" "false"
create_desktop_file "Drive Utility" "fbliveapp driveutility" "driveutility" "GTK;System;" "" "" "false"

refresh_desktop_cache || exit $?
mark_initialized
